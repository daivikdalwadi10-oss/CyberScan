{
  "version": 2,
  "builds": [
    {
      "src": "cyber-sec-saas/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "cyber-sec-saas/frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "cyber-sec-saas/frontend/dist/$1"
    }
  ],
  "outputDirectory": "cyber-sec-saas/frontend/dist"
}
